# Development-only placeholders; keep real values in the ignored .env.
# CRP's memory setting means database connectivity is disabled in this skeleton.
# No business in-memory repositories exist. PostgreSQL failures never fall back to memory.
PERSISTENCE_BACKEND=memory
DATABASE_MODE=memory
DATABASE_URL=postgresql+psycopg://corebanking:change_me_for_cbs_local_development@localhost:5433/corebanking
# Dedicated database, never the development database:
# TEST_DATABASE_URL=postgresql+psycopg://corebanking:change_me_for_cbs_local_development@localhost:5433/core_banking_test

# Identity integration is optional until configured; banking routes are unchanged.
# Use the private listener, never the public /auth API or database.
# AUTH_SERVICE_INTERNAL_URL=https://auth-internal.example.invalid
# AUTH_SERVICE_CREDENTIAL=<64 lowercase hexadecimal characters from service provisioning>
AUTH_SERVICE_ID=cbs-backend
AUTH_APPLICATION_CODE=CBS
AUTH_SESSION_COOKIE_NAME=auth_session
AUTH_REQUEST_TIMEOUT=2.0
AUTH_ALLOW_INSECURE_HTTP=false
APP_ENV=production
# Temporary diagnostic route: opt in only with APP_ENV=development or test.
AUTH_DEBUG_ENDPOINT_ENABLED=false

# Phase 2: authoritative Customer records remain in CRP.
# Operator CLI only; HTTPS origin of a private/trusted CRP backend.
# CRP_CUSTOMER_SERVICE_URL=https://crp-internal.example.invalid
CRP_CUSTOMER_ALLOW_INSECURE_HTTP=false
CRP_CUSTOMER_REQUEST_TIMEOUT=2.0
# Exact browser origins allowed for ADMIN writes; CLI calls need no Origin.
BANKING_TRUSTED_ORIGINS=[]
# Private Customer creation in CRP for self-onboarding; must match CRP's key.
# CRP_CUSTOMER_PROVISIONING_CREDENTIAL=<64 lowercase hex characters>

# Dedicated auth-to-CBS registration key, distinct from session-resolution/CRP keys.
# Private listener only: uvicorn api.internal:app --app-dir src --port 8012
# REGISTRATION_SERVICE_CREDENTIAL=<64 lowercase hex characters>
